+/// Exercise the attachment layout independently of the guest command decoder.
+/// Fetch must read the primary seed, secondary clears must land in their own
+/// images, and depth must reject/accept the primary without changing that order.
+fn check_mrt_attachment_layout(resident: bool, fetch: bool, depth: Option<bool>, count: u32) {
+    let (v, plain) = triangle_spirv();
+    let f = if fetch {
+        translate_words("render_frag_fetch.air", Stage::Fragment)
+    } else {
+        plain
+    };
+    let (w, h) = (16, 16);
+    let mut req = engine_req(&v, &f, w, h);
+    req.color_input = fetch;
+    // Distinct from both shaders' output so ignoring Never cannot pass.
+    req.target_rgba8 = Some(std::sync::Arc::new(
+        [32, 96, 160, 255].repeat((w * h) as usize),
+    ));
+    if resident {
+        req.target_identity = Some(TargetIdentity::Surface {
+            id: 0x700,
+            width: w,
+            height: h,
+            generation: 1,
+        });
+    }
+    if let Some(accept) = depth {
+        req.depth = Some(DepthState {
+            test_enable: true,
+            write_enable: true,
+            compare: if accept {
+                SamplerCompareFunction::Always
+            } else {
+                SamplerCompareFunction::Never
+            },
+            clear_value: 1.0,
+            load: false,
+            stencil: None,
+        });
+    }
+    for n in 0..count {
+        req.secondary_targets.push(SecondaryColorTarget {
+            identity: TargetIdentity::Surface {
+                id: 0x701 + n,
+                width: w,
+                height: h,
+                generation: 1,
+            },
+            width: w,
+            height: h,
+            format: ash::vk::Format::R8G8B8A8_UNORM,
+            clear: [(n + 1) as f32 / 4.0, 0.0, 1.0, 1.0],
+            load: false,
+            blend: None,
+            // The fixture writes only location 0. A zero mask preserves each
+            // secondary clear rather than asserting an undefined shader output.
+            color_write_mask: engine::ColorWriteMask::new(0).unwrap(),
+        });
+    }
+    // Two submissions exercise cached passes and deferred framebuffer cleanup.
+    for _ in 0..2 {
+        let out = engine::execute_draw_request(&req).expect("MRT attachment layout draw");
+        let px = semantic_rgba(&out);
+        let expected = if depth == Some(false) {
+            [32, 96, 160, 255]
+        } else if fetch {
+            [223, 159, 95, 255]
+        } else {
+            [64, 128, 191, 255]
+        };
+        assert_eq!(px.len(), (w * h * 4) as usize);
+        for pixel in px.chunks_exact(4) {
+            assert!(
+                pixel
+                    .iter()
+                    .zip(expected)
+                    .all(|(&got, want)| near(got, want)),
+                "resident={resident} fetch={fetch} depth={depth:?} primary={pixel:?}"
+            );
+        }
+        for (n, sec) in req.secondary_targets.iter().enumerate() {
+            let pixels = engine::read_target(&sec.identity)
+                .expect("secondary readback")
+                .into_rgba8();
+            let expected = [((n + 1) * 255 / 4) as u8, 0, 255, 255];
+            assert_eq!(pixels.len(), (w * h * 4) as usize);
+            for pixel in pixels.chunks_exact(4) {
+                assert!(pixel.iter().zip(expected).all(|(&got, want)| near(got, want)),
+                    "resident={resident} fetch={fetch} depth={depth:?} secondary={n} pixel={pixel:?}");
+            }
+        }
     }
 }
 
+#[test]
+fn mrt_framebuffer_fetch_resident_regression() {
+    let _g = engine_test_session();
+    check_mrt_attachment_layout(true, true, None, 1);
+}
+
+#[test]
+fn mrt_framebuffer_fetch_pooled_regression() {
+    let _g = engine_test_session();
+    check_mrt_attachment_layout(false, true, None, 1);
+}
+
+#[test]
+fn mrt_depth_attachment_matrix() {
+    let _g = engine_test_session();
+    for resident in [false, true] {
+        for fetch in [false, true] {
+            for depth in [None, Some(false), Some(true)] {
+                for count in [1, 3] {
+                    engine::test_reset_engine();
+                    check_mrt_attachment_layout(resident, fetch, depth, count);
+                }
+            }
+        }
+    }
+}
