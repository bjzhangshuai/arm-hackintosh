+#[test]
+fn refresh_tick_signals_exactly_the_classes_the_guest_armed() {
+    for (enable_mask, expected) in [
+        (DISPLAY_VBL_EVENT_MASK, DISPLAY_VBL_EVENT_MASK),
+        (DISPLAY_PRESENT_EVENT_MASK, DISPLAY_PRESENT_EVENT_MASK),
+        (
+            DISPLAY_VBL_EVENT_MASK | DISPLAY_PRESENT_EVENT_MASK,
+            DISPLAY_VBL_EVENT_MASK | DISPLAY_PRESENT_EVENT_MASK,
+        ),
+    ] {
+        let state = DeviceState::new(DeviceId(1), PAGE_SHIFT_ARM64E);
+        let mut host = FakeHost::new();
+        let gpa = 0x7c100000u64 + u64::from(enable_mask) * PAGE_SIZE_ARM64E;
+        host.map_range(gpa, PAGE_SIZE_ARM64E as usize, 0);
+        let mut enable = [0u8; 4];
+        st32(&mut enable, enable_mask);
+        host.write_gpa(gpa + DISPLAY_SHARED_ENABLE_MASK, &enable)
+            .unwrap();
+        signal_display_refresh_classes(
+            &mut host,
+            gpa,
+            0,
+            &state.gfx.interrupt_status_disp,
+            PAGE_SIZE_ARM64E as usize,
+            10_000,
+        );
+        let mut pending = [0u8; 4];
+        host.read_gpa(gpa + DISPLAY_SHARED_PENDING, &mut pending)
+            .unwrap();
+        assert_eq!(ld32(&pending), expected, "enable mask {enable_mask:#x}");
+        assert_eq!(host.actions.len(), 1, "one IRQ serves all armed classes");
+    }
+
+    let state = DeviceState::new(DeviceId(1), PAGE_SHIFT_ARM64E);
+    let mut host = FakeHost::new();
+    let gpa = 0x7c500000u64;
+    host.map_range(gpa, PAGE_SIZE_ARM64E as usize, 0);
+    signal_display_refresh_classes(
+        &mut host, gpa, 0, &state.gfx.interrupt_status_disp,
+        PAGE_SIZE_ARM64E as usize, 10_000,
+    );
+    assert!(host.actions.is_empty(), "an unarmed class must not be invented");
+}
