 }
 
+/// Signal every refresh-completion class currently armed by the guest. Apple
+/// display generations disagree on whether VBL (bit 0) or transaction/present
+/// (bit 1) retires the live frame, so the shared enable word is authoritative.
+/// One read-modify-write and one IRQ serve either or both classes.
+pub(crate) fn signal_display_refresh_classes<H: HostMemory + HostOps>(
+    host: &mut H,
+    gpa: u64,
+    display_index: u32,
+    interrupt_status_disp: &std::sync::atomic::AtomicU32,
+    page_size: usize,
+    now_ms: u64,
+) {
+    let mut enable_le = [0u8; 4];
+    if host
+        .read_gpa(gpa + DISPLAY_SHARED_ENABLE_MASK, &mut enable_le)
+        .is_err()
+    {
+        note_vbl(VBL_NOT_ENABLED, now_ms);
+        return;
+    }
+    let requested = ld32(&enable_le) & (DISPLAY_VBL_EVENT_MASK | DISPLAY_PRESENT_EVENT_MASK);
+    if requested == 0 {
+        note_vbl(VBL_NOT_ENABLED, now_ms);
+        return;
+    }
+    note_vbl(VBL_DELIVERED, now_ms);
+
+    let mut pending_le = [0u8; 4];
+    let pending = if host
+        .read_gpa(gpa + DISPLAY_SHARED_PENDING, &mut pending_le)
+        .is_ok()
+    {
+        ld32(&pending_le)
+    } else {
+        0
+    };
+    let stale_online = pending & DISPLAY_ONLINE_EVENT_MASK != 0;
+    let next = (pending & !DISPLAY_ONLINE_EVENT_MASK) | requested;
+    shared_w32(host, gpa, DISPLAY_SHARED_PENDING, next, page_size);
+    if stale_online {
+        crate::runtime::census::present_proxy::note_stale_online_pending("refresh", pending);
+    }
+    interrupt_status_disp.fetch_or(
+        1u32 << (display_index & 0x1f),
+        std::sync::atomic::Ordering::AcqRel,
+    );
+    host.enqueue(HostAction::irq_gfx());
+}
