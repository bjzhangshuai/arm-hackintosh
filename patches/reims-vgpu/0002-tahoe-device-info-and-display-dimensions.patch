+#[test]
+fn physical_dimensions_keep_integer_float_and_native_aspect_in_sync() {
+    for mm in [DISPLAY_WIDTH_MM, DISPLAY_HEIGHT_MM] {
+        let (as_f32, as_u16) = display_dimension_mm(mm);
+        assert_eq!(as_f32, mm as f32);
+        assert_eq!(as_u16, mm);
+    }
+    assert_eq!(
+        u64::from(DISPLAY_WIDTH_MM) * u64::from(DISPLAY_MODE_EFI_H),
+        u64::from(DISPLAY_HEIGHT_MM) * u64::from(DISPLAY_MODE_EFI_W)
+    );
+    // About 102 DPI in both axes: ordinary desktop density, not HiDPI.
+    let dpi_x10 = |px: u16, mm: u16| u64::from(px) * 254 / u64::from(mm);
+    assert_eq!(
+        dpi_x10(DISPLAY_MODE_EFI_W, DISPLAY_WIDTH_MM),
+        dpi_x10(DISPLAY_MODE_EFI_H, DISPLAY_HEIGHT_MM)
+    );
+}
