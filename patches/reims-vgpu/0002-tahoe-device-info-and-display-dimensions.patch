--- a/crates/reims-vgpu/src/model/regs.rs
+++ b/crates/reims-vgpu/src/model/regs.rs
@@ -249,6 +249,9 @@ pub const DISPLAY_DESC_INDEX: u64 = 0x12;
 pub const DISPLAY_DESC_WIDTH_MM: u64 = 0x14;
 pub const DISPLAY_DESC_HEIGHT_MM: u64 = 0x16;
 pub const DISPLAY_DESC_FEATURES: u64 = 0x1c;
+/// f32 encodings licensed by the negotiated displayDimensionFloats feature.
+pub const DISPLAY_DESC_WIDTH_MM_F32: u64 = 0x24;
+pub const DISPLAY_DESC_HEIGHT_MM_F32: u64 = 0x28;
 /// Timing-element **count** (not a pixel width — large values hang the guest).
 pub const DISPLAY_DESC_TIMING_COUNT: u64 = 0x208;
 
@@ -268,7 +271,27 @@ pub const DISPLAY_MODE3_W: u16 = 3840;
 pub const DISPLAY_MODE3_H: u16 = 2160;
 pub const DISPLAY_SERIAL_NUMBER: u32 = 1;
-pub const DISPLAY_WIDTH_MM: u16 = 400;
-pub const DISPLAY_HEIGHT_MM: u16 = 300;
+/// Physical panel size: 48 x 27 cm is exactly 16:9 and about 102 DPI at the
+/// native 1920x1080 mode. The guest places this in its synthesized EDID.
+pub const DISPLAY_WIDTH_MM: u16 = 480;
+pub const DISPLAY_HEIGHT_MM: u16 = 270;
+
+const _: () = assert!(
+    DISPLAY_WIDTH_MM as u64 * DISPLAY_MODE_EFI_H as u64
+        == DISPLAY_HEIGHT_MM as u64 * DISPLAY_MODE_EFI_W as u64,
+    "physical panel and native mode must have the same aspect"
+);
+const _: () = assert!(
+    DISPLAY_WIDTH_MM % 10 == 0 && DISPLAY_HEIGHT_MM % 10 == 0,
+    "the guest EDID stores physical size in whole centimetres"
+);
+
+/// Produce the two encodings of one physical dimension from one value. Apple
+/// narrows to f32 and rounds the narrowed value for the u16 representation.
+#[inline]
+pub fn display_dimension_mm(millimetres: u16) -> (f32, u16) {
+    let narrowed = millimetres as f32;
+    (narrowed, (narrowed + 0.5) as u16)
+}
 /// Advertised refresh of every timing element. macOS paces CoreAnimation /
 /// rAF to the display's advertised rate, so 60 here caps the guest at 60 fps
 /// regardless of how fast VBL is signalled. 120 requests ProMotion-class
@@ -467,13 +490,32 @@ pub const DEVICE_INFO_CAPS: &[(u32, u32)] = &[
     (34, 8),
     (35, 2048),
     (36, 16),
-    (37, 1009),
+    (37, DEVICE_INFO_GPU_FAMILY),
     (40, 256),
     (41, 7),
     (42, 2),
-    (44, 127),
+    (44, DEVICE_INFO_GPU_FAMILY_SET),
 ];
 
+/// MTLGPUFamily.Apple1; Apple family ordinals are 1000 + n.
+pub const MTL_GPU_FAMILY_APPLE1: u32 = 1001;
+/// This device presents itself as Apple9.
+pub const DEVICE_INFO_GPU_FAMILY: u32 = 1009;
+/// Metal Apple families are cumulative. Key 44 bit zero is Apple5, so Apple9
+/// is exactly bits 0 through 4. Derive the set from key 37 to prevent drift.
+pub const DEVICE_INFO_GPU_FAMILY_SET: u32 =
+    (1u32 << (DEVICE_INFO_GPU_FAMILY - MTL_GPU_FAMILY_APPLE1 - 4 + 1)) - 1;
+const _: () = assert!(
+    DEVICE_INFO_GPU_FAMILY_SET
+        & (1 << (DEVICE_INFO_GPU_FAMILY - MTL_GPU_FAMILY_APPLE1 - 4))
+        != 0
+);
+const _: () = assert!(
+    DEVICE_INFO_GPU_FAMILY_SET
+        >> (DEVICE_INFO_GPU_FAMILY - MTL_GPU_FAMILY_APPLE1 - 3)
+        == 0
+);
+
