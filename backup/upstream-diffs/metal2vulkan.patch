+#[test]
+fn native_i8_record_array_vector_loads_byte_assemble() {
+    // Boot64's first visible Recovery draw hit this shape: the stage/vertex stream is modeled as a
+    // record array whose payload is a flat byte array, but the shader loads wider vectors from offsets
+    // inside that byte payload.  The GEP itself must stay a `uchar` pointer; the following vector loads
+    // must assemble bytes instead of upgrading the pointee and emitting invalid SPIR-V such as
+    // `OpLoad %v4float %_ptr_StorageBuffer_uchar`.
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.3"
+%struct.StageIn = type { [48 x i8] }
+
+define void @StageBytes(i32 %idx, ptr addrspace(1) %stage, ptr addrspace(1) %out, ptr addrspace(1) %hout) {
+entry:
+  %slot = zext i32 %idx to i64
+  %pos_ptr = getelementptr inbounds %struct.StageIn, ptr addrspace(1) %stage, i64 %slot, i32 0, i64 0
+  %pos = load <4 x float>, ptr addrspace(1) %pos_ptr, align 4
+  %half_ptr = getelementptr inbounds %struct.StageIn, ptr addrspace(1) %stage, i64 %slot, i32 0, i64 32
+  %vary = load <4 x half>, ptr addrspace(1) %half_ptr, align 2
+  store <4 x float> %pos, ptr addrspace(1) %out, align 16
+  store <4 x half> %vary, ptr addrspace(1) %hout, align 8
+  ret void
+}
+
+!air.kernel = !{!0}
+!0 = !{ptr @StageBytes, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5, !6}
+!3 = !{i32 0, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint", !"air.arg_name", !"idx"}
+!4 = !{i32 1, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read", !"air.address_space", i32 1, !"air.arg_type_size", i32 48, !"air.arg_type_align_size", i32 1, !"air.arg_type_name", !"uchar", !"air.arg_name", !"stage"}
+!5 = !{i32 2, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 16, !"air.arg_type_align_size", i32 16, !"air.arg_type_name", !"float4", !"air.arg_name", !"out"}
+!6 = !{i32 3, !"air.buffer", !"air.location_index", i32 2, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 8, !"air.arg_type_align_size", i32 8, !"air.arg_type_name", !"half4", !"air.arg_name", !"hout"}
+"#;
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_native_i8_record_array_vector_loads_{}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let spv = crate::translate_sanitized_native(ll, Stage::Kernel, &tmp).expect("translate");
+    let asm = disassemble(&spv).expect("disassemble");
+    assert!(
+        !asm.lines().any(|line| line.contains("OpLoad %v4float")),
+        "{asm}"
+    );
+    assert!(
+        !asm.lines().any(|line| line.contains("OpLoad %v4half")),
+        "{asm}"
+    );
+    assert!(asm.contains("OpTypeInt 8"), "{asm}");
+    assert!(asm.matches("OpLoad").count() >= 8, "{asm}");
+    assert!(asm.contains("OpShiftLeftLogical"), "{asm}");
+    assert!(asm.contains("OpBitwiseOr"), "{asm}");
+    assert!(asm.contains("OpBitcast"), "{asm}");
+    assert!(asm.contains("OpCompositeConstruct"), "{asm}");
+}
