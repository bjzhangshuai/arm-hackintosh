+  %pos2 = insertelement <4 x float> %pos1, float 0.000000e+00, i64 2
+  %pos3 = insertelement <4 x float> %pos2, float 1.000000e+00, i64 3
+  %h0 = fptrunc float 2.500000e-01 to half
+  %h1 = fptrunc float 5.000000e-01 to half
+  %h2 = fptrunc float 7.500000e-01 to half
+  %h3 = fptrunc float 1.000000e+00 to half
+  %c0 = insertelement <4 x half> poison, half %h0, i64 0
+  %c1 = insertelement <4 x half> %c0, half %h1, i64 1
+  %c2 = insertelement <4 x half> %c1, half %h2, i64 2
+  %c3 = insertelement <4 x half> %c2, half %h3, i64 3
+  %out0 = insertvalue <{ <4 x float>, <4 x half> }> undef, <4 x float> %pos3, 0
+  %out1 = insertvalue <{ <4 x float>, <4 x half> }> %out0, <4 x half> %c3, 1
+  ret <{ <4 x float>, <4 x half> }> %out1
+}
+
