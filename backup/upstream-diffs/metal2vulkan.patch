+!1 = !{!2, !3}
+!2 = !{!"air.position", !"air.arg_type_name", !"float4"}
+!3 = !{!"air.vertex_output", !"air.location_index", i32 0, i32 1, !"air.arg_type_name", !"half4", !"air.arg_name", !"color"}
+!4 = !{}
+"#;
+    let tmp = std::env::temp_dir().join(format!(
