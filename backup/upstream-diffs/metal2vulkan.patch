+fn load_var_conversion_op(defs: &HashMap<Word, Instruction>, src_ty: Word, dst_ty: Word) -> Op {
+    if component_float_width(defs, src_ty).is_some() && component_float_width(defs, dst_ty).is_some()
+    {
+        return Op::FConvert;
+    }
+    match component_int_shape(defs, dst_ty) {
