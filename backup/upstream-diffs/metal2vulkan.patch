+#[test]
+fn native_half_location_varyings_use_float32_stage_interface() {
+    fn defs<'a>(module: &'a crate::spirv_module::Module) -> HashMap<Word, &'a Instruction> {
+        module
+            .types_global_values
+            .iter()
+            .filter_map(|inst| inst.result_id.map(|id| (id, inst)))
+            .collect()
+    }
+    fn location_var(
+        module: &crate::spirv_module::Module,
+        storage: StorageClass,
+        location: u32,
+    ) -> Word {
+        let defs = defs(module);
+        module
+            .annotations
+            .iter()
+            .find_map(|inst| match inst.operands.as_slice() {
+                [
+                    Operand::IdRef(var),
+                    Operand::Decoration(Decoration::Location),
+                    Operand::LiteralBit32(loc),
+                ] if *loc == location
+                    && defs.get(var).is_some_and(|def| {
+                        def.class.opcode == Op::Variable
+                            && def.operands.first()
+                                == Some(&Operand::StorageClass(storage))
+                    }) =>
+                {
+                    Some(*var)
+                }
+                _ => None,
+            })
+            .unwrap_or_else(|| panic!("{storage:?} Location {location} variable missing"))
+    }
+    fn pointer_pointee(defs: &HashMap<Word, &Instruction>, var: Word) -> Word {
+        let ptr_ty = defs
+            .get(&var)
+            .and_then(|inst| inst.result_type)
+            .unwrap_or_else(|| panic!("variable {var} has no pointer type"));
+        defs.get(&ptr_ty)
+            .and_then(|ptr| match ptr.operands.get(1) {
+                Some(Operand::IdRef(pointee)) => Some(*pointee),
+                _ => None,
+            })
+            .unwrap_or_else(|| panic!("variable {var} pointer type has no pointee"))
+    }
+    fn is_float_vector(
+        defs: &HashMap<Word, &Instruction>,
+        ty: Word,
+        width: u32,
+        lanes: u32,
+    ) -> bool {
+        let Some(vec_def) = defs.get(&ty) else {
+            return false;
+        };
+        if vec_def.class.opcode != Op::TypeVector {
+            return false;
+        }
+        let (Some(Operand::IdRef(elem)), Some(Operand::LiteralBit32(actual_lanes))) =
+            (vec_def.operands.first(), vec_def.operands.get(1))
+        else {
+            return false;
+        };
+        if *actual_lanes != lanes {
+            return false;
+        }
+        defs.get(elem).is_some_and(|elem_def| {
+            elem_def.class.opcode == Op::TypeFloat
+                && elem_def.operands.first() == Some(&Operand::LiteralBit32(width))
+        })
+    }
+    fn has_fconvert_to_float_vector(
+        module: &crate::spirv_module::Module,
+        defs: &HashMap<Word, &Instruction>,
+        width: u32,
+        lanes: u32,
+    ) -> bool {
+        module.functions.iter().any(|function| {
+            function.blocks.iter().any(|block| {
+                block.instructions.iter().any(|inst| {
+                    inst.class.opcode == Op::FConvert
+                        && inst
+                            .result_type
+                            .is_some_and(|ty| is_float_vector(defs, ty, width, lanes))
+                })
+            })
+        })
+    }
+
+    let vertex_ll = r#"
+source_filename = "synth_half_varying_vertex"
+target datalayout = "e-p:64:64:64"
+target triple = "air64-apple-macosx14.0.0"
