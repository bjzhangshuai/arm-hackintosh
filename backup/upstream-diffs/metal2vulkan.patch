+
+fn component_float_width(defs: &HashMap<Word, Instruction>, ty: Word) -> Option<u32> {
+    let def = defs.get(&ty)?;
+    match def.class.opcode {
+        Op::TypeFloat => match def.operands.first() {
+            Some(Operand::LiteralBit32(width)) => Some(*width),
+            _ => Some(32),
+        },
+        Op::TypeVector => {
+            let elem = match def.operands.first()? {
+                Operand::IdRef(elem) => *elem,
+                _ => return None,
+            };
+            component_float_width(defs, elem)
+        }
+        _ => None,
+    }
+}
+
+fn component_int_shape(defs: &HashMap<Word, Instruction>, ty: Word) -> Option<(u32, bool)> {
+    let def = defs.get(&ty)?;
+    match def.class.opcode {
+        Op::TypeInt => {
+            let bits = match def.operands.first()? {
+                Operand::LiteralBit32(bits) => *bits,
+                _ => return None,
+            };
+            let signed = match def.operands.get(1)? {
+                Operand::LiteralBit32(signed) => *signed != 0,
+                _ => return None,
+            };
+            Some((bits, signed))
+        }
+        Op::TypeVector => {
+            let elem = match def.operands.first()? {
+                Operand::IdRef(elem) => *elem,
+                _ => return None,
+            };
+            component_int_shape(defs, elem)
+        }
+        _ => None,
+    }
+}
