+fn type_def_live<'a>(
+    ctx: &'a Ctx,
+    defs: &'a HashMap<Word, Instruction>,
+    ty: Word,
+) -> Option<&'a Instruction> {
+    defs.get(&ty)
+        .or_else(|| ctx.new_globals.iter().find(|inst| inst.result_id == Some(ty)))
+        .or_else(|| {
+            ctx.module
+                .types_global_values
+                .iter()
+                .find(|inst| inst.result_id == Some(ty))
+        })
 }
 
