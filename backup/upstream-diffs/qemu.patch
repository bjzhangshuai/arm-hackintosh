+
+static bool arm_handle_vmapple_pac_hvc_call(CPUARMState *env,
+                                            uint64_t function_id)
+{
+    switch (function_id) {
+    case QEMU_APPLE_PAC_SET_INITIAL_STATE:
+        arm_vmapple_pac_set_initial_state(env);
+        break;
+    case QEMU_APPLE_PAC_GET_DEFAULT_KEYS:
