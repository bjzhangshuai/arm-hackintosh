+
+static void arm_vmapple_pac_program_el1_user_diversifier(
+    CPUARMState *env, uint64_t diversifier)
+{
+    env->vmapple_pac.el1_user_diversifier = diversifier;
+    arm_vmapple_pac_program_a_pair(
+        &env->vmapple_pac.el1_user_apia,
