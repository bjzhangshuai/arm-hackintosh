+/// A private texture created from a serialized descriptor (object-list type 9).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PlainTextureDescriptor {
+    /// Ref the guest serializer assigned. The object-list slot normally carries
+    /// the same ref; both are kept so diagnostics can catch disagreement without
+    /// having to re-read the descriptor bytes.
+    pub object_ref: u32,
+    /// The shared `PGSerializedTextureDescriptor` decoding, not a second copy of
+    /// its offsets.
+    pub desc: heap_query::TextureDescriptor,
+    /// True when the record carried the wide descriptor body selected by opcode
+    /// 0x34 (`SwizzledTextures`).
+    pub wide: bool,
+}
+
+/// Decode a plain private texture record (`newTextureWithDescriptor:allocator:`).
+///
+/// Tahoe ARM64 can bind these as color attachments. They are deliberately not
+/// decoded as type-2/3: no handle, allocation size or row stride is present, so
+/// a guest-memory Store would be fabricated. The only faithful storage model is
+/// an engine-resident texture keyed by the protocol object ref.
+pub fn decode_plain_texture_descriptor(
+    bytes: &[u8],
+) -> Result<PlainTextureDescriptor, DecodeStatus> {
+    let op = reims_vgpu_wire::op(bytes, 0)
+        .map_err(|_| DecodeStatus::ErrShort("res_plain_texture_len"))?;
+    match op.opcode() {
+        PLAIN_TEXTURE_OPCODE => {
+            if bytes.len() != PLAIN_TEXTURE_LEN {
+                return Err(DecodeStatus::ErrShort("res_plain_texture_len"));
+            }
+            if op.length() as usize != PLAIN_TEXTURE_LEN {
+                return Err(DecodeStatus::ErrShort("res_plain_texture_declared_len"));
+            }
+            let b = w_tex::new_texture(&op)
+                .map_err(|_| DecodeStatus::ErrShort("res_plain_texture_len"))?;
+            let desc = heap_query::decode_serialized_texture_descriptor(
+                &bytes[PLAIN_TEXTURE_DESCRIPTOR
+                    ..PLAIN_TEXTURE_DESCRIPTOR + heap_query::TEXTURE_BODY_LEN],
+            )
+            .map_err(|_| DecodeStatus::ErrUnsupported("res_plain_texture_body"))?;
+            Ok(PlainTextureDescriptor {
+                object_ref: b.object_ref.get(),
+                desc,
+                wide: false,
+            })
+        }
+        PLAIN_TEXTURE_WIDE_OPCODE => {
+            if bytes.len() != PLAIN_TEXTURE_WIDE_LEN {
+                return Err(DecodeStatus::ErrShort("res_plain_texture_len"));
+            }
+            if op.length() as usize != PLAIN_TEXTURE_WIDE_LEN {
+                return Err(DecodeStatus::ErrShort("res_plain_texture_declared_len"));
+            }
+            let b = w_tex::new_texture_wide(&op)
+                .map_err(|_| DecodeStatus::ErrShort("res_plain_texture_len"))?;
+            let desc = heap_query::decode_wide_serialized_texture_descriptor(
+                &bytes[PLAIN_TEXTURE_WIDE_DESCRIPTOR
+                    ..PLAIN_TEXTURE_WIDE_DESCRIPTOR + heap_query::WIDE_TEXTURE_BODY_LEN],
+            )
+            .map_err(|_| DecodeStatus::ErrUnsupported("res_plain_texture_body"))?;
+            Ok(PlainTextureDescriptor {
+                object_ref: b.object_ref.get(),
+                desc,
+                wide: true,
+            })
+        }
+        _ => Err(DecodeStatus::ErrUnsupported("res_plain_texture_opcode")),
+    }
+}
