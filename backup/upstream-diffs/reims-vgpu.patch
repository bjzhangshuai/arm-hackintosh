+#[test]
+fn no_present_census_reports_child_fifo_heads() {
+    let cap = crate::observe::FailCapture::start();
+    let mut state = DeviceState::new(DeviceId(1), PAGE_SHIFT_ARM64E);
+    let mut host = FakeHost::new();
+
+    state.gfx.root_page = 0x20;
+    let root_gpa = state.pfn_gpa(state.gfx.root_page);
+    host.map_range(root_gpa, PAGE_SIZE_ARM64E as usize, 0);
+    let ch = 4u32;
+    let bit = 1u32 << ch;
+    state.active_child_mask |= bit;
+    state.pending.child_mask |= bit;
+    state.child_rings[ch as usize].valid = true;
+    state.child_rings[ch as usize].base_pfn = 0x33;
+    state.child_rings[ch as usize].length = 0x80000;
+
+    let regs = root_gpa + child_reg_block_offset(ch).expect("channel has regs");
+    host.put_u32(regs + CHILD_REG_HEAD, 0x40);
+    host.put_u32(regs + CHILD_REG_TAIL, 0x80);
+    host.put_u32(regs + CHILD_REG_STAMP_INDEX, 7);
+    host.put_u32(regs + CHILD_REG_BASE_PFN, 0x33);
+
+    note_display_no_present_child_census(&mut state, &mut host, 1234);
+    let lines = cap.lines().join("\n");
+    assert!(
+        lines.contains("OFF display_no_present")
+            && lines.contains("ch4:h=64/t=128/s=7/base=0x33/cached_base=0x33/len=0x80000/valid=1"),
+        "no-present census must report live child FIFO registers: {lines}"
+    );
+
+    let cap_after_present = crate::observe::FailCapture::start();
+    state.present.present_epoch = 1;
+    note_display_no_present_child_census(&mut state, &mut host, 2234);
+    assert!(
+        !cap_after_present
+            .lines()
+            .iter()
+            .any(|l| l.contains("display_no_present")),
+        "once a present exists, the no-present boot census must stop"
+    );
+}
