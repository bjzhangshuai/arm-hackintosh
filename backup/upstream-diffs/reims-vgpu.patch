+        !force_apple_device_info_caps(),
+        "unset override must preserve host-derived Vulkan limits"
+    );
+
+    for value in ["1", "true", "TRUE", "yes", "ON"] {
+        std::env::set_var(ENV, value);
+        assert!(
+            force_apple_device_info_caps(),
+            "{value} must opt into the Apple-like diagnostic capability table"
+        );
+    }
+
+    for value in ["", "0", "false", "no", "apple"] {
+        std::env::set_var(ENV, value);
+        assert!(
+            !force_apple_device_info_caps(),
+            "{value:?} must not silently force diagnostic capabilities"
+        );
+    }
+    std::env::remove_var(ENV);
+}
