+fn note_display_no_present_child_census<H: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut H,
+    now_ms: u64,
+) {
+    if state.present.present_epoch != 0 || state.present.present_mapping != 0 {
+        return;
+    }
+    state.fifo_diag.no_present_census_ticks =
+        state.fifo_diag.no_present_census_ticks.saturating_add(1);
+    let tick = state.fifo_diag.no_present_census_ticks;
+    if tick != 1 && !tick.is_multiple_of(VBL_REPORT_EVERY) {
+        return;
+    }
+    if state.gfx.root_page == 0 {
+        crate::observe::off(format!(
+            "display_no_present tick={tick} reason=no_root_page active_mask={:#x} pending_mask={:#x}",
+            state.active_child_mask, state.pending.child_mask
+        ));
+        return;
+    }
+
+    let root_gpa = state.pfn_gpa(state.gfx.root_page);
+    let mut channels = Vec::new();
+    for channel in 1..MAX_CHANNELS {
+        let ch = channel as u32;
+        let bit = 1u32 << ch;
+        if state.active_child_mask & bit == 0 && !state.child_rings[channel].valid {
+            continue;
+        }
+        let Some(regs_off) = child_reg_block_offset(ch) else {
+            continue;
+        };
+        let regs_gpa = root_gpa + regs_off;
+        let head = crate::runtime::host::read_u32(host, regs_gpa + CHILD_REG_HEAD).ok();
+        let tail = crate::runtime::host::read_u32(host, regs_gpa + CHILD_REG_TAIL).ok();
+        let stamp = crate::runtime::host::read_u32(host, regs_gpa + CHILD_REG_STAMP_INDEX).ok();
+        let base = crate::runtime::host::read_u32(host, regs_gpa + CHILD_REG_BASE_PFN).ok();
+        let cached = &state.child_rings[channel];
+        channels.push(format!(
+            "ch{ch}:h={}/t={}/s={}/base={}/cached_base={:#x}/len={:#x}/valid={}",
+            head.map(|v| v.to_string()).unwrap_or_else(|| "?".to_string()),
+            tail.map(|v| v.to_string()).unwrap_or_else(|| "?".to_string()),
+            stamp.map(|v| v.to_string()).unwrap_or_else(|| "?".to_string()),
+            base.map(|v| format!("{v:#x}")).unwrap_or_else(|| "?".to_string()),
+            cached.base_pfn,
+            cached.length,
+            cached.valid as u8
+        ));
+    }
+
+    crate::observe::off(format!(
+        "display_no_present tick={tick} t_ms={now_ms} active_mask={:#x} pending_mask={:#x} \
+         root_pfn={:#x} root_gpa={root_gpa:#x} present_epoch={} channels=[{}]",
+        state.active_child_mask,
+        state.pending.child_mask,
+        state.gfx.root_page,
+        state.present.present_epoch,
+        channels.join(" ")
+    ));
+}
