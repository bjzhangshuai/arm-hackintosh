+
+fn spv_dump_path(prefix: &str, stage: &str, words: &[u32]) -> Option<std::path::PathBuf> {
+    if words.is_empty() {
+        return None;
+    }
+    let path = std::env::temp_dir().join(format!(
+        "reims-vgpu-{}-{}-{}-{}.spv",
+        prefix,
+        std::process::id(),
+        crate::observe::elapsed_ms(),
+        stage
+    ));
+    let mut bytes = Vec::with_capacity(words.len().saturating_mul(4));
+    for word in words {
+        bytes.extend_from_slice(&word.to_le_bytes());
+    }
+    match std::fs::write(&path, bytes) {
+        Ok(()) => Some(path),
+        Err(e) => {
+            let msg = format!("{e:?}").replace(char::is_whitespace, "_");
+            crate::observe::fail(format!(
+                "vk_pipeline_spirv_dump_failed stage={} err={}",
+                stage, msg
+            ));
+            None
+        }
+    }
+}
