+fn resolve_plain_texture_sample_target<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    task_id: u32,
+    texture_ref: u32,
+    entry: Option<ListObjectEntry>,
+) -> Option<RenderTargetResolve> {
+    let (resolved_ref, view_fmt_override, view_level, live) =
+        if let Some(view) = resolve_texture_view(state, host, task_id, texture_ref) {
+            if let Some(plan) = view.swizzle.as_ref() {
+                if !pixel_format::swizzle_is_identity(plan) {
+                    return None;
+                }
+            }
+            let live = objects::lookup_list_entry(state, host, task_id, view.base_texture_ref)?;
+            (view.base_texture_ref, view.pixel_format, view.level, live)
+        } else {
+            let live = entry.or_else(|| objects::lookup_list_entry(state, host, task_id, texture_ref))?;
+            (texture_ref, None, 0, live)
+        };
+    if live.object_type != OBJECT_TYPE_SERIALIZED_TEXTURE {
+        return None;
+    }
+    plain_texture_render_target(
+        state,
+        host,
+        task_id,
+        resolved_ref,
+        &live,
+        view_fmt_override,
+        view_level,
+    )
