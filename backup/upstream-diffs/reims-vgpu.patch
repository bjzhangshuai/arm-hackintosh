+fn dump_pipeline_attempts_enabled() -> bool {
+    matches!(
+        std::env::var("REIMS_VGPU_DUMP_PIPELINE_ATTEMPTS")
+            .ok()
+            .as_deref(),
+        Some("1") | Some("true") | Some("TRUE") | Some("yes") | Some("YES")
