# Copy to vm.env inside a disposable test VM and adjust paths if needed.
MACVM_TEST_VM_CONFIRMED=NO
MACVM_VCPUS=2
MACVM_MEMORY_MIB=8192
MACVM_SSH_FORWARD_PORT=32222
MACVM_QEMU_BIN=./bin/qemu-system-aarch64
MACVM_AVPBOOTER=./assets/apple/ready/AVPBooter.vmapple2.bin
MACVM_AUX=./assets/apple/ready/aux.img.trimmed
MACVM_DISK=./assets/apple/ready/disk.img
MACVM_ECID_FILE=./assets/apple/ready/ecid.txt

